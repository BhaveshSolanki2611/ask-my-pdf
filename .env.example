# Optional in local fallback mode. Set these for the full production stack.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pdf_support_copilot
BLOB_READ_WRITE_TOKEN=
LLAMA_CLOUD_API_KEY=llx-...
AI_GATEWAY_API_KEY=

# Local fallback works without the keys above, but scanned-PDF OCR and hosted answer generation will be unavailable.
ANSWER_MODEL=openai/gpt-5.4
EMBEDDING_MODEL=openai/text-embedding-3-large
MAX_UPLOAD_MB=50
CHUNK_TARGET_TOKENS=800
VECTOR_DIMENSIONS=3072
